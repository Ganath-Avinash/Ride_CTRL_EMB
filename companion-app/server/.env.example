# SentryX Backend Environment Configuration
PORT=5001

# MongoDB Atlas Connection String
# Replace <username>, <password>, and cluster URL with your MongoDB Atlas credentials:
# Example: mongodb+srv://sentryx_admin:mypassword123@cluster0.abcde.mongodb.net/sentryx?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/sentryx?retryWrites=true&w=majority

# Optional: CORS allowed origins (comma separated or * for dev)
CLIENT_ORIGIN=*
